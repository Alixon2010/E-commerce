msgid "Email/telefon yoki parol noto‘g‘ri"
msgstr "Неверный email/телефон или пароль"

#: Shop/serializers.py:483
msgid "Email yoki telefon kiriting"
msgstr "Введите email или телефон"

#: Shop/views.py:67
msgid "Productlarni saralash uchun parameterlar:\n\\- `stars` — reyting bo‘yicha yuqoridan pastga,\n\\- `price_up` — narx bo‘yicha pastdan yuqoriga,\n\\- `price_down` — narx bo‘yicha yuqoridan pastga."
msgstr "Параметры сортировки товаров:\n\\- `stars` — по рейтингу сверху вниз,\n\\- `price_up` — по цене снизу вверх,\n\\- `price_down` — по цене сверху вниз"

#: Shop/views.py:106
msgid "Foydalanuvchi muvaffaqiyatli yaratildi!"
msgstr "Пользователь успешно создан!"

