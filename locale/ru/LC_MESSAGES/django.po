msgid "Google orqali autentifikatsiya. Body ichida `access_token` yuboring.\nMisol: `{ \"access_token\": \"ya29.a0AfH6S...\" }`"
msgstr "Аутентификация через Google. Отправьте `access_token` в теле запроса.\nПример: `{ \"access_token\": \"ya29.a0AfH6S...\" }`"

#: Shop/views.py:330
msgid "Token yuborilmagan"
msgstr "Токен не отправлен"

#: Shop/views.py:337
msgid "Google token noto‘g‘ri"
msgstr "Неверный токен Google"

#: Shop/views.py:379 Shop/views.py:381
msgid "Stripe endpoint secret sozlanmagan"
msgstr "Секрет Stripe не настроен"

#: Shop/views.py:397
msgid "Stripe eventni o‘qishda kutilmagan xato"
msgstr "Неожиданная ошибка при чтении события Stripe"

