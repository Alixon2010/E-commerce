#: Shop/views.py:539
msgid "Ruxsat yo‘q."
msgstr "Ruxsat yo‘q."

msgid "This field is required."
msgstr "Bu maydon majburiy."

msgid "This field may not be null."
msgstr "Bu maydon null bo'lishi mumkin emas."

msgid "Invalid pk \"{pk_value}\" - object does not exist."
msgstr "Noto‘g‘ri pk \"{pk_value}\" - obyekt mavjud emas."

msgid "Invalid input."
msgstr "Noto‘g‘ri kiritish."

msgid "Invalid format."
msgstr "Noto‘g‘ri format."

msgid "Null value not allowed."
msgstr "Null qiymatga ruxsat berilmagan."

msgid "Blank values are not allowed."
msgstr "Bo‘sh qiymatga ruxsat berilmagan."

msgid "Invalid email address."
msgstr "Noto‘g‘ri email manzil."

msgid "Password fields didn't match."
msgstr "Parollar mos kelmadi."

msgid "Ensure this field has no more than {max_length} characters."
msgstr "Bu maydon {max_length} ta belgidan oshmasligi kerak."

msgid "Ensure this field has at least {min_length} characters."
msgstr "Bu maydon kamida {min_length} ta belgidan iborat bo‘lishi kerak."

msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Bu qiymat {min_value} yoki undan katta bo‘lishi kerak."

msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Bu qiymat {max_value} yoki undan kichik bo‘lishi kerak."

msgid "Invalid choice."
msgstr "Noto‘g‘ri tanlov."

msgid "Invalid boolean."
msgstr "Noto‘g‘ri boolean."

msgid "Invalid datetime format. Expected ISO 8601."
msgstr "Noto‘g‘ri datetime formati. ISO 8601 kutilmoqda."

msgid "Invalid date format. Expected ISO 8601."
msgstr "Noto‘g‘ri sana formati. ISO 8601 kutilmoqda."

msgid "Invalid time format. Expected ISO 8601."
msgstr "Noto‘g‘ri vaqt formati. ISO 8601 kutilmoqda."

msgid "Invalid URL."
msgstr "Noto‘g‘ri URL."

msgid "Invalid UUID format."
msgstr "Noto‘g‘ri UUID formati."

msgid "Invalid slug."
msgstr "Noto‘g‘ri slug."

msgid "No query parameter provided."
msgstr "So‘rov parametri berilmagan."

msgid "Invalid token."
msgstr "Noto‘g‘ri token."

msgid "Authentication credentials were not provided."
msgstr "Autentifikatsiya ma’lumotlari berilmagan."

msgid "You do not have permission to perform this action."
msgstr "Bu amalni bajarish uchun ruxsat yo‘q."

msgid "Not found."
msgstr "Topilmadi."

msgid "Method \"{method}\" not allowed."
msgstr "\"{method}\" metodi ruxsat etilmagan."

msgid "Invalid query parameter."
msgstr "Noto‘g‘ri so‘rov parametri."

msgid "Missing required parameter."
msgstr "Majburiy parametr yo‘q."

msgid "Incorrect username or password."
msgstr "Noto‘g‘ri username yoki parol."

msgid "User account is disabled."
msgstr "Foydalanuvchi hisobingiz o‘chirilgan."

msgid "Token is invalid or expired."
msgstr "Token noto‘g‘ri yoki muddati tugagan."